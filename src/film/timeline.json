"lines": [
{
"file": "film/vo/07_0.mp3",
"at": 69.33,
"secs": 5.83,
"who": "n",
"text": "And at Zenith Academy, Yuzu could split a falling leaf at three hundred metres."
},
{
"file": "film/vo/07_1.mp3",
"at": 75.41,
"secs": 3.5,
"who": "yuzu",
"text": "I'll always be the better shot, little brother. Always."
